# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API). See SETUP.md for the full walkthrough.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Any random string. Used to authorize the daily keep-alive cron
# (see vercel.json + src/app/api/keepalive/route.ts) and must also be set
# as an env var on the Vercel project.
CRON_SECRET=

# Only needed locally, only to run `npm run seed` (Project Settings → API →
# service_role). Bypasses Row Level Security — never commit it, never use it
# client-side, and never set it on Vercel.
SUPABASE_SERVICE_ROLE_KEY=
